<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ui.calibration.CalibrationFragment">

    <!-- Título Principal -->
    <TextView
        android:id="@+id/text_calibration_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calibración del Equipo"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- ================= PASO 1: LEER PATRÓN ================= -->
    <TextView
        android:id="@+id/text_step_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PASO 1: Obtener Referencia"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_calibration_title"/>

    <TextView
        android:id="@+id/text_step_1_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Acerque el teléfono al equipo PATRÓN para leer sus valores actuales (0x02)."
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_step_1"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_read_master"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Leer Patrón"
        android:layout_marginTop="12dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:strokeColor="?attr/colorPrimary"
        app:icon="@android:drawable/ic_menu_search"
        app:iconGravity="textStart"
        app:layout_constraintTop_toBottomOf="@id/text_step_1_desc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- SEPARADOR VISUAL -->
    <View
        android:id="@+id/divider_step"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintTop_toBottomOf="@id/btn_read_master"/>

    <!-- ================= PASO 2: TRANSFERIR ================= -->
    <TextView
        android:id="@+id/text_step_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PASO 2: Seleccionar y Transferir"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider_step"/>

    <!-- Selector de Variable (Spinner) -->
    <TextView
        android:id="@+id/label_cal_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Variable a Calibrar:"
        android:textSize="12sp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_step_2"/>

    <Spinner
        android:id="@+id/spinner_calibration_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/label_cal_type"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campo de Entrada: Valor Patrón -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/input_layout_temp_patron"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Valor Patrón a Transferir"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:layout_constraintTop_toBottomOf="@id/spinner_calibration_type"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_text_temp_patron"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal|numberSigned"
            android:textAlignment="center"
            android:textSize="24sp"
            android:textStyle="bold" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/text_helper_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Verifique variable y valor. Luego, acerque el equipo BAJO PRUEBA y presione transferir."
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/input_layout_temp_patron"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Botón de Acción: Transferir -->
    <!-- Usamos un icono del sistema para evitar errores de compilación -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_start_calibration"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Transferir Valor (0x13)"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        app:icon="@android:drawable/ic_menu_send"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:backgroundTint="?attr/colorPrimary"
        app:layout_constraintTop_toBottomOf="@id/text_helper_desc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>


<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.calibration.CalibrationFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <!-- Título Principal -->
            <TextView
                android:id="@+id/text_calibration_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calibración del Equipo"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp" />

            <!-- ================= PASO 1: LEER PATRÓN ================= -->
            <TextView
                android:id="@+id/text_step_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASO 1: Obtener Referencia"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/text_step_1_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Acerque el teléfono al equipo PATRÓN para leer sus valores actuales (0x02)."
                android:textSize="12sp"
                android:textAlignment="center"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_read_master"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Leer Patrón"
                android:layout_marginBottom="24dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="?attr/colorPrimary"
                app:icon="@android:drawable/ic_menu_search"
                app:iconGravity="textStart" />

            <!-- SEPARADOR VISUAL -->
            <View
                android:id="@+id/divider_step"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="24dp"
                android:background="?android:attr/listDivider"/>

            <!-- ================= PASO 2: TRANSFERIR ================= -->
            <TextView
                android:id="@+id/text_step_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASO 2: Seleccionar y Transferir"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <!-- Selector de Variable (Spinner) -->
            <TextView
                android:id="@+id/label_cal_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Variable a Calibrar:"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinner_calibration_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginBottom="12dp" />

            <!-- Campo de Entrada: Volumen Patrón -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_vol_patron"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="Volumen Patrón (L)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_text_vol_patron"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal|numberSigned"
                    android:textAlignment="center"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Campo de Entrada: Temperatura Patrón -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_layout_temp_patron"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Temperatura Patrón (°C)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_text_temp_patron"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal|numberSigned"
                    android:textAlignment="center"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/text_helper_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Verifique los valores. Luego, acerque el equipo BAJO PRUEBA y presione transferir."
                android:textSize="12sp"
                android:textAlignment="center"
                android:layout_marginBottom="16dp"/>

            <!-- Botón de Acción: Transferir (Asegurado al final) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_calibration"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Transferir Ambos (0x13)"
                android:textSize="16sp"
                android:layout_marginBottom="32dp"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                app:icon="@android:drawable/ic_menu_send"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:backgroundTint="?attr/colorPrimary" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:id="@+id/layout_languages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="120dp" android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_lang_es"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/flag_arg"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerCrop"
            android:layout_marginEnd="24dp"
            android:contentDescription="@string/desc_lang_es" />

        <ImageButton
            android:id="@+id/btn_lang_en"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/flag_usa"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerCrop"
            android:layout_marginEnd="24dp"
            android:contentDescription="@string/desc_lang_en" />

        <ImageButton
            android:id="@+id/btn_lang_zh"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/flag_ch"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerCrop"
            android:contentDescription="@string/desc_lang_zh" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_languages"
        app:layout_constraintVertical_bias="0.4">

        <ImageView
            android:id="@+id/statusIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@android:drawable/stat_sys_data_bluetooth"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@string/desc_nfc_status_icon"
            android:layout_marginBottom="24dp"
            tools:src="@android:drawable/stat_sys_data_bluetooth" />

        <TextView
            android:id="@+id/statusMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_nfc_idle"
            android:textSize="18sp"
            android:textAlignment="center"
            android:textColor="?android:attr/textColorPrimary" />

    </LinearLayout>

    <TextView
        android:id="@+id/text_app_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="RevX.XX"
        android:textSize="14sp"
        android:textColor="#808080"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.notifications.NotificationsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header de Registros NDEF -->
        <TextView
            android:id="@+id/text_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:textAlignment="center"
            android:textSize="20sp"
            android:text="Información completa de registros NDEF"
            android:layout_marginBottom="16dp"/>

        <!-- Registro N° 1 (Identidad) -->
        <TextView
            android:id="@+id/textViewIdentityRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:text="Registro N° 1 (Identidad):\n"
            android:layout_marginBottom="8dp"/>

        <!-- Registro N° 2 (Proceso) -->
        <TextView
            android:id="@+id/textViewProcessRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:text="Registro N° 2 (Proceso):\n"
            android:layout_marginBottom="8dp"/>

        <!-- Registro N° 3 (Configuración) -->
        <TextView
            android:id="@+id/textViewConfigurationRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:text="Registro N° 3 (Configuración):\n"
            android:layout_marginBottom="8dp"/>

        <!-- Registro N° 3 (Configuración) -->
        <TextView
            android:id="@+id/textViewRawRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:text="Registro N° 3 (Configuración):\n"
            android:layout_marginBottom="8dp"/>

        <!-- SECCIÓN: HISTORIAL DEL PROTOCOLO NFC -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="Historial del Protocolo NFC"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Botón para Limpiar Logs -->
        <Button
            android:id="@+id/buttonClearLogs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="Limpiar Historial"
            android:layout_marginBottom="8dp"/>

        <!-- TextView para mostrar los Logs (Fondo oscuro para simular una consola) -->
        <TextView
            android:id="@+id/textViewProtocolLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/black"
            android:textColor="@android:color/holo_green_light"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textSize="12sp"
            android:minHeight="200dp"
            android:text="[00:00:00] Logs de actividad del protocolo aparecerán aquí..."
            android:gravity="top"
            android:scrollbars="vertical" />

    </LinearLayout>

</ScrollView>
